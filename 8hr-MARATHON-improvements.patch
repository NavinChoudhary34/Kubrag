+    # so '"CONVERSATIONAL".' and "`conversational`" both normalise correctly.
+    cleaned = (raw or "").strip().strip("`'\" \n.!")
+    if cleaned.upper() == "CONVERSATIONAL":
+        return "CONVERSATIONAL"
+    return cleaned or fallback_query
