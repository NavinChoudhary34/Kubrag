+from unittest.mock import MagicMock
+
+from app.services.retrieval import ranking_service
+
+DOCS = [
+    {"content": "alpha", "source": "a.txt", "score": 0.5},
+    {"content": "beta", "source": "b.txt", "score": 0.4},
+    {"content": "gamma", "source": "c.txt", "score": 0.3},
+]
